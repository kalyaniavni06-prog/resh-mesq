# ──────────────────────────────────────────────────────────────────
# RESH MESQ — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your REAL Supabase project values.
#
# Get these from: Supabase Dashboard → Settings → API
#   - Project URL:  https://YOUR_PROJECT_REF.supabase.co
#   - API Key:      sb_publishable_XXXX  (or the legacy anon key eyJ...)
#
# IMPORTANT: Also set VITE_* variables in your Vercel dashboard
# (Project Settings → Environment Variables) so the production
# build picks them up at compile time.
# ──────────────────────────────────────────────────────────────────

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
